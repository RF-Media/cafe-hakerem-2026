# Database — Postgres (Neon free tier recommended) locally and in production
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Resend (transactional email) — CoffeeStream's Resend account.
# Use a café-only key with "Sending access", restricted to the sender domain,
# so it can be revoked without touching CoffeeStream.
RESEND_API_KEY=""
# Must be on a domain verified in that Resend account. *.vercel.app can't be
# verified (no DNS control) — use the per-client subdomain (hakerem.coffeestream.co.il) until a cafehakerem
# one is verified, then change only this value.
RESEND_FROM="קפה הכרם <orders@hakerem.coffeestream.co.il>"

# Where order + inquiry notifications are sent (internal address)
CAFE_NOTIFICATION_EMAIL=""

# Internal copy of every customer confirmation (same branded email + a banner
# with the amount to collect). Comma-separated; sent on every order, even when
# the customer left no email. Add the seller here when they're onboarded.
ORDER_COPY_EMAILS="info@coffeestream.co.il"

# Public site URL (sitemap.ts, schema, and the logo in confirmation emails).
# Until the domain is live, set it to the Vercel URL or the email logo breaks.
NEXT_PUBLIC_SITE_URL="https://cafehakerem.co.il"

# Upstash Redis — rate limiting for /api/jachnun-order and /api/catering-inquiry
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Pre-launch site gate (HTTP Basic Auth via middleware.ts). Unset both to
# open the site — no redeploy needed.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
